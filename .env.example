# ---------------------------------------------------------------------------
# Public environment variables (safe to expose to the browser).
# NEVER put server-only secrets (service role key, DB password) with a
# NEXT_PUBLIC_ prefix or anywhere in src/app/api client bundles.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used for SEO metadata / Open Graph / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowed origins for API CORS (comma separated). Defaults to NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only variables (never exposed to the client, never prefixed with
# NEXT_PUBLIC_). Uncomment when server-side admin operations are needed.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Support assistant (/api/assistant) — OPTIONAL.
# Without a key the assistant answers from its built-in knowledge base
# (src/lib/assistant/knowledge.ts), so the widget works out of the box.
# Set a key to upgrade it to a language model: any OpenAI-compatible endpoint
# works (OpenAI, DeepSeek, Groq, OpenRouter, a local Ollama, ...).
# ---------------------------------------------------------------------------
# ASSISTANT_API_KEY=sk-your-key
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4o-mini

# Direct Postgres connection (Supabase Dashboard -> Settings -> Database).
# Used only by local migration scripts: npm run db:apply / db:anon-key.
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres
